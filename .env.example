# PRICOVA Full-Stack Environment Variables Example

# Backend Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/pricova
JWT_SECRET=pricova_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=30d

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@pricova.com
ADMIN_PASSWORD=Admin@123

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
